{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "instructions": [".opencode/AGENTS.md"],
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "partitures *", "effect": "allow" },
    { "action": "shell", "resource": "~/.local/bin/partitures *", "effect": "allow" },
    { "action": "shell", "resource": "& \"$env:USERPROFILE\\.local\\bin\\partitures.cmd\" *", "effect": "allow" },
    { "action": "shell", "resource": "partitures harmonia fitxa *", "effect": "allow" },
    { "action": "shell", "resource": "partitures harmonia comprova *", "effect": "allow" },
    { "action": "shell", "resource": "~/.local/bin/partitures harmonia *", "effect": "allow" },
    { "action": "shell", "resource": "& \"$env:USERPROFILE\\.local\\bin\\partitures.cmd\" harmonia *", "effect": "allow" },
    { "action": "shell", "resource": "partitures instalar *", "effect": "ask" },
    { "action": "shell", "resource": "~/.local/bin/partitures instalar *", "effect": "ask" },
    { "action": "shell", "resource": "& \"$env:USERPROFILE\\.local\\bin\\partitures.cmd\" instalar *", "effect": "ask" },
    { "action": "shell", "resource": "partitures nivell esborra *", "effect": "ask" },
    { "action": "shell", "resource": "partitures preferencia esborra *", "effect": "ask" },
    { "action": "shell", "resource": "~/.local/bin/partitures nivell esborra *", "effect": "ask" },
    { "action": "shell", "resource": "~/.local/bin/partitures preferencia esborra *", "effect": "ask" },
    { "action": "shell", "resource": "& \"$env:USERPROFILE\\.local\\bin\\partitures.cmd\" nivell esborra *", "effect": "ask" },
    { "action": "shell", "resource": "& \"$env:USERPROFILE\\.local\\bin\\partitures.cmd\" preferencia esborra *", "effect": "ask" },
    { "action": "shell", "resource": "partitures actualitzar", "effect": "ask" },
    { "action": "shell", "resource": "partitures actualitzar *", "effect": "ask" },
    { "action": "shell", "resource": "~/.local/bin/partitures actualitzar", "effect": "ask" },
    { "action": "shell", "resource": "~/.local/bin/partitures actualitzar *", "effect": "ask" },
    { "action": "shell", "resource": "& \"$env:USERPROFILE\\.local\\bin\\partitures.cmd\" actualitzar", "effect": "ask" },
    { "action": "shell", "resource": "& \"$env:USERPROFILE\\.local\\bin\\partitures.cmd\" actualitzar *", "effect": "ask" },
    { "action": "shell", "resource": "ls", "effect": "allow" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "pwd", "effect": "allow" },
    { "action": "shell", "resource": "rm *", "effect": "deny" },
    { "action": "shell", "resource": "del *", "effect": "deny" },
    { "action": "shell", "resource": "erase *", "effect": "deny" },
    { "action": "shell", "resource": "rmdir *", "effect": "deny" },
    { "action": "shell", "resource": "rd *", "effect": "deny" },
    { "action": "shell", "resource": "Remove-Item *", "effect": "deny" },
    { "action": "shell", "resource": "mv *", "effect": "deny" },
    { "action": "shell", "resource": "move *", "effect": "deny" },
    { "action": "shell", "resource": "Move-Item *", "effect": "deny" },
    { "action": "shell", "resource": "git push*", "effect": "deny" },
    { "action": "edit", "resource": "*", "effect": "deny" },
    { "action": "webfetch", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "skill", "resource": "*", "effect": "allow" }
  ]
}
