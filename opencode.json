{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "uv run partitures *", "effect": "allow" },
    { "action": "shell", "resource": "~/.local/bin/uv run partitures *", "effect": "allow" },
    { "action": "shell", "resource": "& \"$env:USERPROFILE\\.local\\bin\\uv.exe\" run partitures *", "effect": "allow" },
    { "action": "shell", "resource": "uv sync", "effect": "allow" },
    { "action": "shell", "resource": "uv --version", "effect": "allow" },
    { "action": "shell", "resource": "ls", "effect": "allow" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "pwd", "effect": "allow" },
    { "action": "shell", "resource": "rm *", "effect": "deny" },
    { "action": "shell", "resource": "del *", "effect": "deny" },
    { "action": "shell", "resource": "erase *", "effect": "deny" },
    { "action": "shell", "resource": "rmdir *", "effect": "deny" },
    { "action": "shell", "resource": "rd *", "effect": "deny" },
    { "action": "shell", "resource": "Remove-Item *", "effect": "deny" },
    { "action": "shell", "resource": "mv *", "effect": "deny" },
    { "action": "shell", "resource": "move *", "effect": "deny" },
    { "action": "shell", "resource": "Move-Item *", "effect": "deny" },
    { "action": "shell", "resource": "git push*", "effect": "deny" },
    { "action": "edit", "resource": "*", "effect": "deny" },
    { "action": "webfetch", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "skill", "resource": "*", "effect": "allow" }
  ]
}
