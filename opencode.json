{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "uv run partitures *": "allow",
      "uv sync": "allow",
      "ls": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "open *": "ask",
      "rm *": "deny",
      "del *": "deny",
      "git push*": "deny"
    },
    "edit": "deny",
    "webfetch": "allow",
    "skill": { "*": "allow" }
  }
}
